{
  "name": "numero-ci",
  "version": "0.1.0",
  "description": "Numéros de téléphone ivoiriens : normalisation, opérateur, et rapprochement entre l'ancien format à 8 chiffres et le nouveau à 10.",
  "keywords": [
    "cote-divoire",
    "ivory-coast",
    "telephone",
    "phone",
    "numero",
    "orange",
    "mtn",
    "moov",
    "afrique",
    "mobile-money"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "verifier": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
