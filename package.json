{
  "name": "numero-ci",
  "version": "0.2.0",
  "description": "Ivorian phone numbers: normalisation, operator detection, and matching between the legacy 8-digit format and the current 10-digit one.",
  "keywords": [
    "cote-divoire",
    "ivory-coast",
    "telephone",
    "phone",
    "numero",
    "orange",
    "mtn",
    "moov",
    "afrique",
    "mobile-money"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "verifier": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zakbot-agent/numero-ci.git"
  },
  "bugs": {
    "url": "https://github.com/zakbot-agent/numero-ci/issues"
  },
  "homepage": "https://github.com/zakbot-agent/numero-ci#readme",
  "author": "ZakBOT (pour Zakaria Koné)"
}
